# Copy to .env for the local app. Keep credentials and run state out of source control.
PORT=3000

# Optional hybrid gateway. The companion's dedicated listener defaults to 3001.
# Start it with npm run companion on your own Linux Docker/gVisor host.
COMPANION_PORT=3001
# Hosted server only: the real public HTTPS companion origin, without a path.
# Example: https://companion.example.com. Leave blank until your host is ready.
FORGE_COMPANION_URL=
# Same strict base64url-encoded 32-byte random secret on gateway and companion.
# Keep the hosted UI/API private. HMAC authenticates the gateway, not visitors.
# Set securely on both servers; never put the value in a browser URL or source.
# Use a separate secret from OAUTH_SESSION_SECRET. Required for companion mode.
FORGE_COMPANION_SECRET=

# Existing trusted project directory, preferably a small Git repository.
# npm run demo sets this to its persistent .forge/demo fixture for that process.
FORGE_WORKSPACE=
# Optional absolute directory for local task records, tool traces and proposals.
# Default: .forge/coding-runs beneath the app; demo default: .forge/demo-runs.
FORGE_STATE_DIR=

# Local inference. Install Ollama and pull a model yourself before running tasks.
# qwen2.5-coder:7b is a starting point; stronger coding models need more hardware.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# More context consumes more memory. Supported: 2048–131072; app default: 8192.
OLLAMA_CONTEXT_WINDOW=16384

# Prebuilt local runner images. Docker with the gVisor runsc runtime is required.
# The app never pulls images or falls back to executing source on the host.
FORGE_NODE_IMAGE=easy-agent-runner:local
FORGE_PYTHON_IMAGE=dazza-forge-eval:local

# OpenAI Responses API. API usage is billed separately from ChatGPT/Codex plans.
# Reuse your existing key through the server secret manager, never browser settings.
# OPENAI_API_KEY may be supplied as a server secret; no value is included here.
# Choose a text model available to your project; catalog listing alone cannot
# establish that a model supports the Responses API or your requested features.
OPENAI_MODEL=

# Google Vertex AI through Google's remote MCP endpoint. Cloud usage is billable.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Set a model ID available to your project and location; the app has a default.
VERTEX_MODEL=
# Local auth: gcloud auth application-default login; no browser credentials.
# GOOGLE_APPLICATION_CREDENTIALS may reference a server-side credentials file.
# Short-lived access tokens are optional and expire without refresh.
GOOGLE_ACCESS_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_JSON can be supplied as a server secret if required.
# Do not paste service-account keys into the app UI or commit them to this file.

# Local read-only CLI profiles. Defaults use PATH; overrides are executable paths,
# not shell commands. Install and authenticate each CLI on the server yourself.
GH_BIN=gh
GCLOUD_BIN=gcloud
HF_BIN=hf
# Optional owner/repository default for GitHub CLI repository reads.
GH_REPO=
# Regional CLI reads need a region, even when Vertex inference uses global.
GOOGLE_CLOUD_REGION=us-central1
# Existing CLOUDSDK_CONFIG / GH_CONFIG_DIR / HF_HOME are respected when supplied.
# gcloud auth login is separate from gcloud auth application-default login.

# GitHub remote MCP and CLI authorization are checked independently.
# GH_TOKEN is an alternative to GITHUB_TOKEN; do not enter tokens in browser UI.
GITHUB_TOKEN=
# Hugging Face token is optional for public catalog reads, required for identity.
HF_TOKEN=

# OAuth sessions for AWeber, GetResponse and Sandcastles only.
# Strict base64url encoding of 32 random bytes. When blank, local startup creates
# and reuses ignored .forge/oauth-session.key with private file permissions.
# Cloud deployments must configure a durable server secret.
# Tokens stay encrypted in HttpOnly cookies and require external provider consent.
OAUTH_SESSION_SECRET=

# Documented shared MCP endpoints. Tokens are server secrets, never browser inputs.
CLOUDFLARE_MCP_URL=https://mcp.cloudflare.com/mcp
# Accepted Cloudflare API token or MCP OAuth access token.
CLOUDFLARE_MCP_TOKEN=
SENTRY_MCP_URL=https://mcp.sentry.dev/mcp
# MCP OAuth access token. SENTRY_ACCESS_TOKEN is not a Bearer substitute.
SENTRY_MCP_TOKEN=
HUGGINGFACE_MCP_URL=https://huggingface.co/mcp
AWEBER_MCP_URL=https://mcp.aweber.com/mcp
GETRESPONSE_MCP_URL=https://mcp.getresponse.com
SANDCASTLES_MCP_URL=https://mcp.sandcastles.ai/
# The three OAuth connections above do not require pasting access tokens.

# User-owned or explicitly selected deployments; no account endpoint is assumed.
# Allow each chosen public HTTPS hostname in MCP_ALLOWED_HOSTS below.
REDDIT_MCP_URL=
REDDIT_MCP_TOKEN=
NVIDIA_MCP_URL=
NVIDIA_MCP_TOKEN=
ORCA_MCP_URL=
ORCA_MCP_TOKEN=
OMNIROUTE_MCP_URL=
OMNIROUTE_MCP_TOKEN=
AGENT_OS_MCP_URL=
AGENT_OS_MCP_TOKEN=
EASY_AGENT_MCP_URL=
EASY_AGENT_MCP_TOKEN=

# Additional Streamable HTTP MCP hosts are opt-in and server-controlled.
# Server entries reference token environment variable names, never token values.
MCP_ALLOWED_HOSTS=
MCP_SERVERS_JSON=[]
