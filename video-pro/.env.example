# Local-only app. Never expose this server through a public tunnel.
VIDEO_PORT=18806
# Disabled until provider access and cost controls are verified.
VIDEO_LIVE_ENABLED=false
GEMINI_API_KEY=
# Reserved for future adapters. Presence alone does not enable them.
RUNWAY_API_KEY=
# Exact CloudFront CDN hostname from a verified Runway response, if used.
RUNWAY_MEDIA_HOSTS=
ELEVENLABS_API_KEY=
FIRECRAWL_API_KEY=
# Optional server-side Supabase identity; URL/key/owner UUIDs must all be set.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_OWNER_IDS=
# Billing remains disabled while config/plans.json has billingEnabled=false.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_BUSINESS=
