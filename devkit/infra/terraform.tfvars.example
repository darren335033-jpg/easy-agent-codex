# Copy to terraform.tfvars and replace these identifiers before planning.
project_id  = "ai-code-model-dev-uniqueid"
bucket_name = "ai-code-model-dev-uniqueid-artifacts"
region      = "us-central1"

# Existing project is the default. Confirm billing is active on that project.
create_project = false

# Optional new project (requires project creation and billing association access):
# create_project  = true
# billing_account = "012345-6789AB-CDEF01"
# folder_id       = "123456789012"

# Optional monthly alerts. Choose an amount and the billing account currency.
# Alerts can arrive after charges accrue and do not stop usage.
# enable_budget   = true
# billing_account = "012345-6789AB-CDEF01"
# budget_amount   = 100
# budget_currency = "USD"

# Optional Google remote MCP IAM access; server enablement is a separate step.
# enable_vertex_mcp_access = true

# Optional archived object cleanup; null keeps all object generations.
# noncurrent_version_retention_days = 30
